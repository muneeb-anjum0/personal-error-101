    "@muneeb-systems/shared-types": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
